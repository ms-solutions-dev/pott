          "stringUnit": {
            "state": "translated",
            "value": "Die Einkommensteuer, die direkt vom Gehalt abgezogen wird. Wie viel, hängt von Steuerklasse, Kinderfreibeträgen und dem Steuertarif ab."
          }
        }
      }
    },
    "Increase by 0.1": {

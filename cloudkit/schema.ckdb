DEFINE SCHEMA

    RECORD TYPE "cloudkit.share" (
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE QUERYABLE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title"              STRING,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Household (
        CD_createdAt           TIMESTAMP,
        CD_entityName          STRING QUERYABLE,
        CD_id                  STRING,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING,
        CD_name_ckAsset        ASSET,
        CD_rule                STRING,
        CD_rule_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Member (
        CD_createdAt              TIMESTAMP,
        CD_entityName             STRING QUERYABLE,
        CD_fixedContributionCents INT64,
        CD_household              STRING,
        CD_id                     STRING,
        CD_monthlyNetIncomeCents  INT64,
        CD_moveReceipt            BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset    ASSET,
        CD_name                   STRING,
        CD_name_ckAsset           ASSET,
        CD_shareBasisPoints       INT64,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_FixedCost (
        CD_amountCents         INT64,
        CD_category            STRING,
        CD_category_ckAsset    ASSET,
        CD_contractEnd         TIMESTAMP,
        CD_createdAt           TIMESTAMP,
        CD_dueDay              INT64,
        CD_entityName          STRING QUERYABLE,
        CD_household           STRING,
        CD_id                  STRING,
        CD_isPaused            INT64,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING,
        CD_name_ckAsset        ASSET,
        CD_note                STRING,
        CD_note_ckAsset        ASSET,
        CD_noticePeriodDays    INT64,
        CD_recurrence          STRING,
        CD_recurrence_ckAsset  ASSET,
        CD_scope               STRING,
        CD_scope_ckAsset       ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Income (
        CD_createdAt             TIMESTAMP,
        CD_entityName            STRING QUERYABLE,
        CD_id                    STRING,
        CD_monthlyNetCents       INT64,
        CD_moveReceipt           BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset   ASSET,
        CD_name                  STRING,
        CD_name_ckAsset          ASSET,
        CD_note                  STRING,
        CD_note_ckAsset          ASSET,
        CD_originSummary         STRING,
        CD_originSummary_ckAsset ASSET,
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SavingsGoal (
        CD_createdAt           TIMESTAMP,
        CD_entityName          STRING QUERYABLE,
        CD_household           STRING,
        CD_id                  STRING,
        CD_months              INT64,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING,
        CD_name_ckAsset        ASSET,
        CD_note                STRING,
        CD_note_ckAsset        ASSET,
        CD_savedCents          INT64,
        CD_scope               STRING,
        CD_scope_ckAsset       ASSET,
        CD_targetCents         INT64,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MonthSummary (
        CD_contributionCents   INT64,
        CD_createdAt           TIMESTAMP,
        CD_entityName          STRING QUERYABLE,
        CD_fixedCostsCents     INT64,
        CD_id                  STRING,
        CD_incomeCents         INT64,
        CD_leftCents           INT64,
        CD_month               STRING,
        CD_month_ckAsset       ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_savingsCents        INT64,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
